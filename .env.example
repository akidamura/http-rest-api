# Адрес сервера
BIND_ADDR=:8080

# Уровень логирования: debug, info, warn, error
LOG_LEVEL=info

LOG_FORMAT=text    # text для разработки, json для прода

# Подключение к MySQL
# MySQL DSN: user:password@tcp(host:port)/dbname
DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASSWORD=change-me
DB_NAME=restapi_dev

SESSION_KEY=change-me-to-random-64-hex-chars
